{
  // Read only by the test runner (scripts/run-tests.mjs, via TSX_TSCONFIG_PATH)
  // -- never by typecheck or the build, both of which resolve tsconfig.json as
  // normal. The runner has no bundler to hand the JSX transform to, so it
  // needs the automatic runtime to actually execute a component; the app's
  // real "jsx": "preserve" is correct for the bundler and stays untouched.
  //
  // The ui package is listed because its exports map publishes raw `.tsx`
  // source rather than a built boundary, so a shared component rendered under
  // this runner executes those files inside this program.
  //
  // What listing them changes is NOT established, and the two claims that
  // used to stand here are worse than absent. Removing this entry and
  // rendering a ui component under this runner still rendered, so it settles
  // nothing observable today. A separate measurement found that a file no
  // `include` claims loses its compiler options rather than falling back to
  // its own package's tsconfig, which is the reverse of what this comment
  // asserted for years. Both questions are open. The entry is kept as the
  // narrower, explicit behaviour -- not because its effect has been shown.
  //
  // It has never been about how these files' imports resolve; the package
  // states that itself, by importing by package name.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx"
  },
  "include": ["**/*.ts", "**/*.tsx", "../../packages/ui/src/**/*.ts", "../../packages/ui/src/**/*.tsx"]
}
