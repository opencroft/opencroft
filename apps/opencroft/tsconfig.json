{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // "@/..." is the app's own alias and resolves only under the app root.
    // Dependencies must not rely on it: a package reached as raw source
    // through its exports map imports itself by package name, so its internal
    // specifiers resolve identically here, in another package's tests, and in
    // the bundler.
    "paths": {
      "@/*": ["./*"]
    },
    // A dependency-free *.test.ts imports its sibling module with an explicit
    // .ts extension so `node --experimental-strip-types` can run it without the
    // tool host. Allowed because noEmit is inherited from the base config.
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "node", "dom-navigation"]
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": [
    "node_modules",
    "data/extensions/**",
    "data/agent-workspace/**",
    "data/agent-harness-home/**",
    "backup/**"
  ]
}
