{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "extends": "//",
  "linter": {
    "rules": {
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["@/*", "**/apps/**", "**/app/_authed/**"],
                "message": "packages/agent-chat is a host-agnostic package (reused beyond this app) — it may depend on agent-client and ui, never on the host app. Take whatever this needs as a prop/extension point instead."
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/src/components/**", "!**/src/components/**/*.test.ts", "!**/src/components/**/*.test.tsx"],
      "formatter": { "enabled": false },
      "assist": { "enabled": false }
    }
  ]
}
